@model web_Thoi_Trang_admin.Models.ProductEditViewModel

@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="container my-4">
    <h2>Quản lý Chi tiết Sản phẩm</h2>
    <hr />

    @using (Html.BeginForm("Edit", "SanPhams", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.MaSanPham)

        <div class="card mb-4 p-4 shadow-sm border-0" style="border-radius: 12px;">
            <h4 class="mb-3 text-primary">Thông tin chung sản phẩm</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm</label>
                    @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.TenSanPham, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Danh mục</label>
                    @Html.DropDownList("MaDanhMuc", null, new { @class = "form-control" })
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả sản phẩm</label>
                @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Đường dẫn hình ảnh đại diện</label>
                @Html.TextBoxFor(m => m.HinhAnhDaiDien, new { @class = "form-control" })
            </div>
        </div>

        <!-- 2. BẢNG QUẢN LÝ BIẾN THỂ -->
        <div class="card mb-4 p-4 shadow-sm border-0" style="border-radius: 12px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-primary m-0">Biến thể sản phẩm (SKU, Màu, Size, Giá, Tồn kho)</h4>
                <button type="button" class="btn btn-sm btn-success" id="addVariantBtn">
                    <i class="bi bi-plus-lg"></i> Thêm biến thể mới
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="variantsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Mã SKU</th>
                            <th>Màu sắc</th>
                            <th>Kích cỡ (Size)</th>
                            <th>Giá bán (VNĐ)</th>
                            <th>Tồn kho</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.BienThes.Count; i++)
                        {
                            <tr>
                                @Html.HiddenFor(m => m.BienThes[i].MaBienThe)
                                <td>
                                    @Html.TextBoxFor(m => m.BienThes[i].MaSKU, new { @class = "form-control form-control-sm", placeholder = "SKU..." })
                                </td>
                                <td>
                                    @Html.TextBoxFor(m => m.BienThes[i].MauSac, new { @class = "form-control form-control-sm", placeholder = "VD: Đen" })
                                </td>
                                <td>
                                    @Html.TextBoxFor(m => m.BienThes[i].KichCo, new { @class = "form-control form-control-sm", placeholder = "VD: L" })
                                </td>
                                <td>
                                    @Html.TextBoxFor(m => m.BienThes[i].GiaBan, new { @class = "form-control form-control-sm", type = "number", step = "0.01" })
                                </td>
                                <td>
                                    @Html.TextBoxFor(m => m.BienThes[i].SoLuongTon, new { @class = "form-control form-control-sm", type = "number" })
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-trash"></i> Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="@Url.Action("Index", "SanPhams")" class="btn btn-secondary">Quay lại danh sách</a>
            <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
        </div>
    }
</div>

<script>
    document.getElementById("addVariantBtn").addEventListener("click", function () {
        var tableBody = document.querySelector("#variantsTable tbody");
        var index = tableBody.rows.length;

        var newRow = document.createElement("tr");
        newRow.innerHTML = `
            <input type="hidden" name="BienThes[${index}].MaBienThe" value="0" />
            <td><input type="text" name="BienThes[${index}].MaSKU" class="form-control form-control-sm" placeholder="Mã SKU" required /></td>
            <td><input type="text" name="BienThes[${index}].MauSac" class="form-control form-control-sm" placeholder="VD: Đen" required /></td>
            <td><input type="text" name="BienThes[${index}].KichCo" class="form-control form-control-sm" placeholder="VD: M" required /></td>
            <td><input type="number" name="BienThes[${index}].GiaBan" class="form-control form-control-sm" value="0" step="0.01" required /></td>
            <td><input type="number" name="BienThes[${index}].SoLuongTon" class="form-control form-control-sm" value="0" required /></td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-trash"></i> Xóa</button>
            </td>
        `;
        tableBody.appendChild(newRow);
    });

    document.addEventListener("click", function (e) {
        if (e.target && e.target.closest(".remove-row")) {
            var row = e.target.closest("tr");
            row.remove();
        }
    });
</script>