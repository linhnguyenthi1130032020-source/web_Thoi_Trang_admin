
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="auth-card" style="max-width: 450px; margin: 40px auto; background: #ffffff; border-radius: 16px; padding: 32px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08); border: 1px solid #e2e8f0;">
    <div style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-size: 26px; font-weight: 800; color: var(--ink); margin-bottom: 8px;">Đăng Nhập</h2>
        <p style="color: var(--muted); font-size: 14px; margin: 0;">Chào mừng bạn quay trở lại với NOVEASTORE</p>
    </div>

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <!-- 🛑 KHUNG THÔNG BÁO LỖI MÀU ĐỎ KHI SAI TÀI KHOẢN HOẶC MẬT KHẨU -->
        if (!ViewData.ModelState.IsValid)
        {
            <div style="background-color: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 8px;">
                <i class="bi bi-exclamation-circle-fill" style="font-size: 16px;"></i>
                <div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin: 0; list-style: none; padding: 0;" })
                </div>
            </div>
        }

        <!-- Tên đăng nhập -->
        <div style="margin-bottom: 18px;">
            <label for="username" style="display: block; font-weight: 600; color: #334155; margin-bottom: 6px; font-size: 14px;">Tên đăng nhập / Email</label>
            <div style="position: relative;">
                <input type="text" id="username" name="username" class="form-control-modern" placeholder="Nhập tên đăng nhập hoặc email" required style="padding-left: 42px !important;" />
                <i class="bi bi-person" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 18px;"></i>
            </div>
        </div>

        <!-- Mật khẩu -->
        <div style="margin-bottom: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label for="password" style="font-weight: 600; color: #334155; font-size: 14px; margin: 0;">Mật khẩu</label>
                <a href="#" style="color: var(--brand); font-size: 13px; text-decoration: none; font-weight: 500;">Quên mật khẩu?</a>
            </div>
            <div style="position: relative;">
                <input type="password" id="password" name="password" class="form-control-modern" placeholder="Nhập mật khẩu" required style="padding-left: 42px !important;" />
                <i class="bi bi-lock" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 18px;"></i>
            </div>
        </div>

        <!-- Ghi nhớ đăng nhập -->
        <div style="display: flex; align-items: center; margin-bottom: 24px;">
            <input type="checkbox" id="rememberMe" name="rememberMe" style="accent-color: var(--brand); width: 16px; height: 16px; cursor: pointer;" />
            <label for="rememberMe" style="margin-left: 8px; color: #4b5563; font-size: 14px; cursor: pointer;">Ghi nhớ đăng nhập</label>
        </div>

        <button type="submit" class="btn-brand" style="width: 100%; text-align: center; padding: 12px; font-size: 16px; border-radius: 10px; cursor: pointer;">
            Đăng nhập
        </button>
    }

    <div style="text-align: center; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 18px; font-size: 14px; color: var(--muted);">
        Chưa có tài khoản?
        <a href="@Url.Action("Register", "Account")" style="color: var(--brand); font-weight: 700; text-decoration: none;">Đăng ký ngay</a>
    </div>
</div>