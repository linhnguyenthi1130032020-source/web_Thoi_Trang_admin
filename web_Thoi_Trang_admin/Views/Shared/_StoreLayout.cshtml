<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - NOVÉASTORE</title>

    <!-- Nạp CSS mặc định và Bootstrap -->
    @Styles.Render("~/Content/css")
    <link href="~/Content/store.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    <!-- Topbar thông báo -->
    <div class="store-topbar bg-dark text-white py-2 text-center small tracking-wide">
        <div class="container">
            <i class="bi bi-megaphone-fill me-2 text-warning"></i>Siêu sale ngày đôi 11/11 giảm đến 50% cho đơn hàng từ 999.000đ
        </div>
    </div>

    <!-- Header & Navigation Bar (Chỉ có các mục cho khách, KHÔNG chứa menu quản lý) -->
    <header class="store-header bg-white shadow-sm sticky-top">
        <div class="container py-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <!-- Logo thương hiệu -->
            <a class="brand text-decoration-none fs-3 fw-bold text-dark" href="@Url.Action("Index","Store")">
                NOVÉA<span class="text-primary">STORE</span>
            </a>

            <!-- Menu điều hướng dành cho khách hàng -->
            <nav class="store-nav d-flex align-items-center gap-4 flex-wrap">
                @Html.ActionLink("Trang chủ", "Index", "Home", null, new { @class = "text-decoration-none text-dark fw-semibold" })
                @Html.ActionLink("Giới thiệu", "AboutStore", "Home", null, new { @class = "text-decoration-none text-dark fw-semibold" })
                @Html.ActionLink("Cửa hàng", "Index", "Store", null, new { @class = "text-decoration-none text-dark fw-semibold" })

                <!-- Nút Đăng nhập -->
                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                    <i class="bi bi-person-circle me-1"></i> Đăng nhập
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer chung cho khách -->
    <footer class="bg-dark text-white text-center py-4 mt-auto">
        <div class="container small text-muted">
            &copy; 2026 - Bản quyền thuộc về <strong>NOVÉASTORE</strong>
        </div>
    </footer>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>