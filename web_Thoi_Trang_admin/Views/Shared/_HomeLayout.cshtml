<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - NOVEASTORE</title>

    <!-- Nạp CSS mặc định và Bootstrap -->
    @Styles.Render("~/Content/css")
    <link href="~/Content/store.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    @Scripts.Render("~/bundles/modernizr")
</head>


    <!-- Sửa từ <body class="d-flex flex-column min-vh-100 bg-light"> thành: -->
<body class="d-flex flex-column min-vh-100" style="background-color: var(--page);">

    <!-- Header & Navigation Bar dành riêng cho Trang chủ / Khách hàng -->
    <div class="container" style="max-width: 1300px; margin: 0 auto; padding: 0 1.5rem;">
        <header class="store-header" style="background: #0f172a !important; border-bottom: 1px solid #1e293b !important;">
            <div class="container" style="max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; display: flex; align-items: center; min-height: 72px;">
                <a href="@Url.Action("Index", "Home")" class="brand" style="color: #ffffff !important;">NOVEA<span>STORE</span></a>

                </a>

                <!-- Menu điều hướng trang chủ (Không có các nút quản lý) -->
                <nav class="store-nav d-flex align-items-center gap-4 flex-wrap">

                    <!-- Nút Đăng nhập cho Admin -->
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="bi bi-person-circle me-1"></i> Đăng nhập
                    </a>
                </nav>
            </div>
        </header>

        <!-- Main Content Area: Nơi hiển thị banner trang chủ và thông tin giới thiệu -->
        <main class="flex-grow-1">
            @RenderBody()
        </main>

        <!-- Footer trang chủ -->
        <footer class="bg-dark text-white text-center py-4 mt-auto">
            <div class="container small text-muted">
                &copy; 2026 - Bản quyền thuộc về <strong>NOVEASTORE</strong>
            </div>
        </footer>

        <!-- Scripts -->
        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @RenderSection("scripts", required: false)
</body>
</html>