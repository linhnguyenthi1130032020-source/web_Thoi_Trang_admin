<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị NOVEASTORE</title>

    <!-- Chỉ gọi file CSS bên ngoài, không viết CSS trong này nữa -->
    <link href="@Url.Content("~/Content/Store.css")" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <!-- THANH THÔNG BÁO ĐẦU TRANG -->
    <div class="store-topbar">
        <div class="topbar-ticker-wrap">
            <div class="ticker-item">🔥 Voucher giảm 10% cho đơn hàng có giá trị 1.000.000đ</div>
            <div class="ticker-item">🔥 Voucher giảm 15% cho đơn hàng có giá trị 1.000.000đ(chỉ áp cho sản phẩm trong bộ sưu tập ) </div>
            <div class="ticker-item">🔥 Voucher giảm 20% cho đơn hàng có giá trị 2.000.000đ</div>
            <div class="ticker-item">🔥 Voucher giảm 30% cho đơn hàng có giá trị 3.000.000đ</div>
            <div class="ticker-item">⚡ Miễn phí vận chuyển toàn quốc cho đơn hàng đầu tiên </div>
            <div class="ticker-item">💎 Voucher giảm 40% cho đơn hàng có giá trị từ 4.000.000đ</div>
            <div class="ticker-item">💎 Voucher giảm 50% cho đơn hàng có giá trị từ 5.000.000đ</div>
        </div>
    </div>

    <!-- HEADER / LOGO + MENU -->
    <header class="store-header">
        <div class="container" style="max-width: 1300px; margin: 0 auto; padding: 0 1.5rem;">
            <a href="@Url.Action("Index", "Home")" class="brand">NOVEA<span>STORE</span></a>

            <nav class="store-nav">
                @Html.ActionLink("Trang chủ", "Index", "Home")
                @Html.ActionLink("Quản lý sản phẩm", "Index", "SanPhams")
                @Html.ActionLink("Quản lý danh mục", "Index", "DanhMucs")
                @Html.ActionLink("Quản lý đơn hàng", "Index", "DonHangs")
                @Html.ActionLink("Đơn hàng ", "Index", "CustomerOrders")
                @Html.ActionLink("Tổng doanh thu", "Revenue", "Statistics")
            </nav>


            <div style="margin-left: 15px;">
                <a href="@Url.Action("Login", "Account")" class="btn-brand" style="padding: 6px 16px; font-size: 14px; border-radius: 20px;">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng Xuất 
                </a>
            </div>
        </div>
    </header>

    <!-- KHUNG NỘI DUNG CHÍNH -->
    <main class="container" style="width: 100%; max-width: 1300px; margin: 2rem auto; padding: 0 1.5rem;">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="store-footer">
        <div class="container" style="max-width: 1300px; margin: 0 auto; padding: 0 1.5rem;">
            <strong>NOVEASTORE</strong> &copy; @DateTime.Now.Year - Hệ thống quản lý thời trang chuyên nghiệp
        </div>
    </footer>

    @RenderSection("scripts", required: false)
</body>
</html>